{
  // 不再 extends "@vue/tsconfig/tsconfig.json"（v0.1.3）：
  // 该预设包含 TypeScript 5.5 已移除的 importsNotUsedAsValues / preserveValueImports，
  // 会被新版 TS 报错。此处将其等价配置内联到下方 compilerOptions 中。
  "compilerOptions": {
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["esnext", "dom"],
    "types": ["@dcloudio/types"],

    // ===== 以下为原 @vue/tsconfig 基础预设的等价配置（去掉已删除选项后内联）=====
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    // Vue 项目必需：JSX 交由 vue-tsc / 编译器处理
    "jsx": "preserve",
    // noImplicitThis 已包含在 strict 中，此处显式声明以保证关闭 strict 时仍生效
    "noImplicitThis": true,
    "strict": true,
    // Vite 要求：每个文件必须是可独立转译的模块
    "isolatedModules": true,
    // 原 `preserveValueImports` + `importsNotUsedAsValues: "error"` 的语义在 TS 5.x
    // 由 `verbatimModuleSyntax` 承担；本工程本地 TS 为 4.9（不识别该选项），
    // 且导入语法已统一使用 `import type`，故此处直接移除这两个已废弃选项。
    // 若后续升级到 TypeScript >= 5.0，可在此处补上： "verbatimModuleSyntax": true
    "target": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"]
}

